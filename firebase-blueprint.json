{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private profile and optional Supabase link configuration for an authenticated Gmail user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of the user."
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Verified Gmail address."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "User display name."
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional avatar URL."
        },
        "supabaseUrl": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional linked Supabase project URL."
        },
        "supabaseAnonKey": {
          "type": "string",
          "maxLength": 500,
          "description": "Optional linked Supabase public anon key."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last update."
        }
      },
      "required": ["uid", "email", "displayName", "updatedAt"]
    },
    "AuthorizedEmail": {
      "title": "AuthorizedEmail",
      "description": "Role-based access control grant for a Gmail address.",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Lowercase authorized Gmail address."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name or label for the invited member."
        },
        "role": {
          "type": "string",
          "enum": ["admin", "manager", "staff", "viewer"],
          "description": "Assigned role."
        },
        "allowBarcode": {
          "type": "boolean",
          "description": "Permission to scan and manage barcodes."
        },
        "allowSchedule": {
          "type": "boolean",
          "description": "Permission to register and manage work schedules."
        },
        "allowExport": {
          "type": "boolean",
          "description": "Permission to export Excel reports."
        },
        "allowSupabase": {
          "type": "boolean",
          "description": "Permission to configure and sync with Supabase."
        },
        "scheduleLevel": {
          "type": "string",
          "enum": ["view", "edit", "manage", "admin"],
          "description": "Optional granular schedule RBAC level."
        },
        "active": {
          "type": "boolean",
          "description": "Whether access is currently active."
        },
        "note": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional admin note."
        },
        "grantedBy": {
          "type": "string",
          "maxLength": 254,
          "description": "Admin email that created or updated this grant."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "email",
        "displayName",
        "role",
        "allowBarcode",
        "allowSchedule",
        "allowExport",
        "allowSupabase",
        "active",
        "note",
        "grantedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "BarcodeScan": {
      "title": "BarcodeScan",
      "description": "A scanned or manually entered barcode record belonging to an authorized user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Owner email."
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "description": "Decoded barcode value."
        },
        "format": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "description": "Barcode symbology format or capture method."
        },
        "sessionName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "description": "Batch or inventory session name."
        },
        "quantity": {
          "type": "integer",
          "description": "Count of items scanned for this barcode."
        },
        "note": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional item note."
        },
        "syncedToSupabase": {
          "type": "boolean",
          "description": "Whether this record has been synced to Supabase."
        },
        "scannedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when scanned."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when last updated."
        }
      },
      "required": [
        "ownerId",
        "ownerEmail",
        "code",
        "format",
        "sessionName",
        "quantity",
        "note",
        "syncedToSupabase",
        "scannedAt",
        "updatedAt"
      ]
    },
    "WorkSchedule": {
      "title": "WorkSchedule",
      "description": "Legacy work schedule entry preserved for backward compatibility.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Owner Firebase Auth UID."
        },
        "ownerEmail": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254,
          "description": "Owner email."
        },
        "employeeName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Staff or registrant name."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150,
          "description": "Shift title or task description."
        },
        "workDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Scheduled date in YYYY-MM-DD format."
        },
        "shiftType": {
          "type": "string",
          "enum": ["morning", "afternoon", "evening", "full_day", "custom"],
          "description": "Shift category."
        },
        "startTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "description": "Shift start time HH:MM."
        },
        "endTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "description": "Shift end time HH:MM."
        },
        "location": {
          "type": "string",
          "maxLength": 150,
          "description": "Workplace or warehouse location."
        },
        "status": {
          "type": "string",
          "enum": ["registered", "confirmed", "completed", "cancelled"],
          "description": "Schedule status."
        },
        "note": {
          "type": "string",
          "maxLength": 400,
          "description": "Optional shift notes."
        },
        "syncedToSupabase": {
          "type": "boolean",
          "description": "Whether this schedule is synced to Supabase."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "ownerId",
        "ownerEmail",
        "employeeName",
        "title",
        "workDate",
        "shiftType",
        "startTime",
        "endTime",
        "location",
        "status",
        "note",
        "syncedToSupabase",
        "createdAt",
        "updatedAt"
      ]
    },
    "ShiftRegistration": {
      "title": "ShiftRegistration",
      "description": "Staff shift or day-off registration pending manager/admin review.",
      "type": "object",
      "properties": {
        "staffUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the registering staff member."
        },
        "staffName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of staff."
        },
        "department": {
          "type": "string",
          "maxLength": 120,
          "description": "Staff department or position."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Registered date in YYYY-MM-DD."
        },
        "shiftType": {
          "type": "string",
          "enum": [
            "ca_sang",
            "hanh_chinh",
            "ca_chieu",
            "parttime_1700",
            "parttime_1730",
            "parttime_1800",
            "do",
            "al",
            "ph",
            "nb"
          ],
          "description": "Standard shift or leave code."
        },
        "note": {
          "type": "string",
          "maxLength": 300,
          "description": "Optional note up to 300 characters."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Approval workflow status."
        },
        "memberUids": {
          "type": "array",
          "description": "Authorized member UIDs."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Firebase Auth UID of creator."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "staffUid",
        "staffName",
        "department",
        "date",
        "shiftType",
        "note",
        "status",
        "memberUids",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "OfficialWorkSchedule": {
      "title": "OfficialWorkSchedule",
      "description": "Official weekly work schedule entry displayed in the matrix.",
      "type": "object",
      "properties": {
        "staffUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Assigned staff UID or deterministic staff key."
        },
        "staffName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Staff full name."
        },
        "department": {
          "type": "string",
          "maxLength": 120,
          "description": "Department or job title."
        },
        "date": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Date in YYYY-MM-DD."
        },
        "shiftType": {
          "type": "string",
          "enum": [
            "ca_sang",
            "hanh_chinh",
            "ca_chieu",
            "parttime_1700",
            "parttime_1730",
            "parttime_1800",
            "do",
            "al",
            "ph",
            "nb"
          ],
          "description": "Standard shift or leave code."
        },
        "startTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "description": "Shift start time HH:mm."
        },
        "endTime": {
          "type": "string",
          "minLength": 5,
          "maxLength": 5,
          "pattern": "^[0-9]{2}:[0-9]{2}$",
          "description": "Shift end time HH:mm."
        },
        "isPublished": {
          "type": "boolean",
          "description": "Whether the schedule is visible on the official weekly matrix."
        },
        "sourceRegId": {
          "type": "string",
          "maxLength": 128,
          "description": "Optional linked shiftRegistrations document ID."
        },
        "note": {
          "type": "string",
          "maxLength": 300,
          "description": "Shift note up to 300 characters."
        },
        "isTrucDam": {
          "type": "boolean",
          "description": "Whether the staff member is on Truc Dam duty."
        },
        "memberUids": {
          "type": "array",
          "description": "Authorized member UIDs."
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Creator Firebase Auth UID."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "staffUid",
        "staffName",
        "department",
        "date",
        "shiftType",
        "startTime",
        "endTime",
        "isPublished",
        "sourceRegId",
        "note",
        "isTrucDam",
        "memberUids",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "ScheduleWeeklyMatrixConfig": {
      "title": "ScheduleWeeklyMatrixConfig",
      "description": "System-wide display order and visibility config for the weekly schedule matrix.",
      "type": "object",
      "properties": {
        "sortMode": {
          "type": "string",
          "enum": ["custom", "name_asc", "name_desc", "position_asc", "shifts_desc"],
          "description": "Active matrix row sorting mode."
        },
        "customOrder": {
          "type": "array",
          "description": "Ordered list of staffUid values."
        },
        "hiddenUids": {
          "type": "array",
          "description": "List of hidden staffUid values."
        },
        "memberUids": {
          "type": "array",
          "description": "Authorized member UIDs."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of last editor."
        },
        "updatedByName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Display name of last editor."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "sortMode",
        "customOrder",
        "hiddenUids",
        "memberUids",
        "updatedBy",
        "updatedByName",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and Supabase link settings, readable and writable only by the owning user."
    },
    "/authorized_emails/{emailId}": {
      "schema": { "$ref": "#/entities/AuthorizedEmail" },
      "description": "Admin-managed Gmail allowlist and role/module permission assignments."
    },
    "/barcode_scans/{scanId}": {
      "schema": { "$ref": "#/entities/BarcodeScan" },
      "description": "Continuous barcode scan logs owned by authorized users."
    },
    "/work_schedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/WorkSchedule" },
      "description": "Legacy work schedule registrations and shift logs."
    },
    "/shiftRegistrations/{regId}": {
      "schema": { "$ref": "#/entities/ShiftRegistration" },
      "description": "Staff shift and day-off registrations synchronized in real time."
    },
    "/workSchedules/{scheduleId}": {
      "schema": { "$ref": "#/entities/OfficialWorkSchedule" },
      "description": "Official weekly work schedules synchronized in real time."
    },
    "/scheduleConfigs/{configId}": {
      "schema": { "$ref": "#/entities/ScheduleWeeklyMatrixConfig" },
      "description": "Weekly matrix sort order and staff visibility config (doc weekly_matrix)."
    }
  }
}
