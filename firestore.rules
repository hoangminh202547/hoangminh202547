rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core helper functions
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true && request.auth.token.email is string;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function emailToKey(email) {
      return email.lower().replace('@', '_at_').replace('[.]', '_dot_').replace('[^a-z0-9_\\-]', '_');
    }

    function authEmailKey() {
      return emailToKey(request.auth.token.email);
    }

    function isSuperAdmin() {
      return isVerified() && request.auth.token.email.lower() == 'hoangminh202547@gmail.com';
    }

    function hasAccessDoc() {
      return isVerified() && exists(/databases/$(database)/documents/authorized_emails/$(authEmailKey()));
    }

    function accessData() {
      return get(/databases/$(database)/documents/authorized_emails/$(authEmailKey())).data;
    }

    function isAuthorizedUser() {
      return isSuperAdmin() || (hasAccessDoc() && accessData().active == true);
    }

    function isAdmin() {
      return isSuperAdmin() || (hasAccessDoc() && accessData().active == true && accessData().role == 'admin');
    }

    function isManagerOrAdmin() {
      return isSuperAdmin() || (hasAccessDoc() && accessData().active == true && accessData().role in ['admin', 'manager']);
    }

    function isViewer() {
      return hasAccessDoc() && accessData().active == true && accessData().role == 'viewer';
    }

    function canUseBarcode() {
      return isSuperAdmin() || (isAuthorizedUser() && accessData().allowBarcode == true && accessData().role != 'viewer');
    }

    function canUseSchedule() {
      return isSuperAdmin() || (isAuthorizedUser() && accessData().allowSchedule == true && accessData().role != 'viewer');
    }

    function isScheduleEditor() {
      return isSuperAdmin() || (
        isAuthorizedUser()
        && accessData().allowSchedule == true
        && accessData().role != 'viewer'
        && (
          accessData().role in ['admin', 'manager'] ||
          ('scheduleLevel' in accessData() && accessData().scheduleLevel in ['edit', 'manage', 'admin'])
        )
      );
    }

    function isScheduleManager() {
      return isSuperAdmin() || (
        isAuthorizedUser()
        && accessData().allowSchedule == true
        && accessData().role != 'viewer'
        && (
          accessData().role in ['admin', 'manager'] ||
          ('scheduleLevel' in accessData() && accessData().scheduleLevel in ['manage', 'admin'])
        )
      );
    }

    function isScheduleAdmin() {
      return isSuperAdmin() || (
        isAuthorizedUser()
        && accessData().allowSchedule == true
        && (
          accessData().role == 'admin' ||
          ('scheduleLevel' in accessData() && accessData().scheduleLevel == 'admin')
        )
      );
    }

    function isScheduleShiftCode(code) {
      return code is string && code in [
        'ca_sang',
        'hanh_chinh',
        'ca_chieu',
        'parttime_1700',
        'parttime_1730',
        'parttime_1800',
        'do',
        'al',
        'ph',
        'nb'
      ];
    }

    function isValidMemberUids(listData) {
      return listData is list
        && listData.size() >= 1
        && listData.size() <= 200
        && listData[0] is string
        && isValidId(listData[0]);
    }

    function isValidUidArray(listData) {
      return listData is list
        && listData.size() <= 300
        && (listData.size() == 0 || (listData[0] is string && isValidId(listData[0])));
    }

    // Validation blueprint: UserProfile
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'photoURL', 'supabaseUrl', 'supabaseAnonKey', 'updatedAt'])
        && data.uid is string
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.email is string
        && data.email.lower() == request.auth.token.email.lower()
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('supabaseUrl' in data) || (data.supabaseUrl is string && data.supabaseUrl.size() <= 300))
        && (!('supabaseAnonKey' in data) || (data.supabaseAnonKey is string && data.supabaseAnonKey.size() <= 500))
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Validation blueprint: AuthorizedEmail
    function isValidAuthorizedEmail(data, emailId) {
      return data.keys().hasAll([
          'email', 'displayName', 'role', 'allowBarcode', 'allowSchedule',
          'allowExport', 'allowSupabase', 'active', 'note', 'grantedBy',
          'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'email', 'displayName', 'role', 'allowBarcode', 'allowSchedule',
          'allowExport', 'allowSupabase', 'scheduleLevel', 'active', 'note', 'grantedBy',
          'createdAt', 'updatedAt'
        ])
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.email == data.email.lower()
        && emailToKey(data.email) == emailId
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.role is string
        && data.role in ['admin', 'manager', 'staff', 'viewer']
        && data.allowBarcode is bool
        && data.allowSchedule is bool
        && data.allowExport is bool
        && data.allowSupabase is bool
        && (!('scheduleLevel' in data) || (data.scheduleLevel is string && data.scheduleLevel in ['view', 'edit', 'manage', 'admin']))
        && data.active is bool
        && data.note is string
        && data.note.size() <= 300
        && data.grantedBy is string
        && data.grantedBy.size() >= 3
        && data.grantedBy.size() <= 254
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Validation blueprint: BarcodeScan
    function isValidBarcodeScan(data) {
      return data.keys().hasAll([
          'ownerId', 'ownerEmail', 'code', 'format', 'sessionName',
          'quantity', 'note', 'syncedToSupabase', 'scannedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'ownerEmail', 'code', 'format', 'sessionName',
          'quantity', 'note', 'syncedToSupabase', 'scannedAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerEmail is string
        && data.ownerEmail.size() >= 3
        && data.ownerEmail.size() <= 254
        && data.code is string
        && data.code.size() >= 1
        && data.code.size() <= 200
        && data.format is string
        && data.format.size() >= 1
        && data.format.size() <= 40
        && data.sessionName is string
        && data.sessionName.size() >= 1
        && data.sessionName.size() <= 100
        && data.quantity is int
        && data.quantity >= 1
        && data.quantity <= 999999
        && data.note is string
        && data.note.size() <= 300
        && data.syncedToSupabase is bool
        && data.scannedAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Validation blueprint: Legacy WorkSchedule
    function isValidWorkSchedule(data) {
      return data.keys().hasAll([
          'ownerId', 'ownerEmail', 'employeeName', 'title', 'workDate',
          'shiftType', 'startTime', 'endTime', 'location', 'status',
          'note', 'syncedToSupabase', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'ownerEmail', 'employeeName', 'title', 'workDate',
          'shiftType', 'startTime', 'endTime', 'location', 'status',
          'note', 'syncedToSupabase', 'createdAt', 'updatedAt'
        ])
        && data.ownerId is string
        && isValidId(data.ownerId)
        && data.ownerEmail is string
        && data.ownerEmail.size() >= 3
        && data.ownerEmail.size() <= 254
        && data.employeeName is string
        && data.employeeName.size() >= 1
        && data.employeeName.size() <= 120
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 150
        && data.workDate is string
        && data.workDate.size() == 10
        && data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.shiftType is string
        && data.shiftType in ['morning', 'afternoon', 'evening', 'full_day', 'custom']
        && data.startTime is string
        && data.startTime.size() == 5
        && data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.endTime is string
        && data.endTime.size() == 5
        && data.endTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.location is string
        && data.location.size() <= 150
        && data.status is string
        && data.status in ['registered', 'confirmed', 'completed', 'cancelled']
        && data.note is string
        && data.note.size() <= 400
        && data.syncedToSupabase is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Validation blueprint: ShiftRegistration
    function isValidShiftRegistration(data) {
      return data.keys().hasAll([
          'staffUid', 'staffName', 'department', 'date', 'shiftType',
          'note', 'status', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'staffUid', 'staffName', 'department', 'date', 'shiftType',
          'note', 'status', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.staffUid)
        && data.staffName is string
        && data.staffName.size() >= 1
        && data.staffName.size() <= 120
        && data.department is string
        && data.department.size() <= 120
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isScheduleShiftCode(data.shiftType)
        && data.note is string
        && data.note.size() <= 300
        && data.status is string
        && data.status in ['pending', 'approved', 'rejected']
        && isValidMemberUids(data.memberUids)
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Validation blueprint: OfficialWorkSchedule (workSchedules)
    function isValidOfficialWorkSchedule(data) {
      return data.keys().hasAll([
          'staffUid', 'staffName', 'department', 'date', 'shiftType',
          'startTime', 'endTime', 'isPublished', 'sourceRegId', 'note',
          'isTrucDam', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'staffUid', 'staffName', 'department', 'date', 'shiftType',
          'startTime', 'endTime', 'isPublished', 'sourceRegId', 'note',
          'isTrucDam', 'memberUids', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.staffUid)
        && data.staffName is string
        && data.staffName.size() >= 1
        && data.staffName.size() <= 120
        && data.department is string
        && data.department.size() <= 120
        && data.date is string
        && data.date.size() == 10
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && isScheduleShiftCode(data.shiftType)
        && data.startTime is string
        && data.startTime.size() == 5
        && data.startTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.endTime is string
        && data.endTime.size() == 5
        && data.endTime.matches('^[0-9]{2}:[0-9]{2}$')
        && data.isPublished is bool
        && (data.sourceRegId == null || isValidId(data.sourceRegId))
        && data.note is string
        && data.note.size() <= 300
        && data.isTrucDam is bool
        && isValidMemberUids(data.memberUids)
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Validation blueprint: ScheduleWeeklyMatrixConfig (scheduleConfigs/weekly_matrix)
    function isValidScheduleConfig(data) {
      return data.keys().hasAll([
          'sortMode', 'customOrder', 'hiddenUids', 'memberUids',
          'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'sortMode', 'customOrder', 'hiddenUids', 'memberUids',
          'updatedBy', 'updatedByName', 'createdAt', 'updatedAt'
        ])
        && data.sortMode is string
        && data.sortMode in ['custom', 'name_asc', 'name_desc', 'position_asc', 'shifts_desc']
        && isValidUidArray(data.customOrder)
        && isValidUidArray(data.hiddenUids)
        && isValidMemberUids(data.memberUids)
        && isValidId(data.updatedBy)
        && data.updatedByName is string
        && data.updatedByName.size() >= 1
        && data.updatedByName.size() <= 120
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && data.updatedAt == request.time;
    }

    // Users collection (PII isolated per owner)
    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming());
      allow update: if isVerified() && isValidId(userId) && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'supabaseUrl', 'supabaseAnonKey', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // Authorized Emails RBAC collection
    match /authorized_emails/{emailId} {
      allow get: if isValidId(emailId) && (
        isAdmin() || (isVerified() && emailId == authEmailKey())
      );
      allow list: if isAdmin();
      allow create: if isAdmin() && isValidId(emailId)
        && isValidAuthorizedEmail(incoming(), emailId)
        && incoming().createdAt == request.time;
      allow update: if isAdmin() && isValidId(emailId)
        && isValidAuthorizedEmail(incoming(), emailId)
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().email != 'hoangminh202547@gmail.com'
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'role', 'allowBarcode', 'allowSchedule',
          'allowExport', 'allowSupabase', 'scheduleLevel', 'active', 'note', 'grantedBy', 'updatedAt'
        ]);
      allow delete: if isAdmin() && isValidId(emailId)
        && existing().email != 'hoangminh202547@gmail.com';
    }

    // Barcode Scans collection
    match /barcode_scans/{scanId} {
      allow get: if isValidId(scanId) && isAuthorizedUser() && (
        existing().ownerId == request.auth.uid || isManagerOrAdmin() || isViewer()
      );
      allow list: if isAuthorizedUser() && (
        existing().ownerId == request.auth.uid || isManagerOrAdmin() || isViewer()
      );
      allow create: if canUseBarcode() && isValidId(scanId)
        && isValidBarcodeScan(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().ownerEmail.lower() == request.auth.token.email.lower()
        && incoming().scannedAt == request.time;
      allow update: if canUseBarcode() && isValidId(scanId)
        && (existing().ownerId == request.auth.uid || isManagerOrAdmin())
        && isValidBarcodeScan(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().ownerEmail == existing().ownerEmail
        && incoming().scannedAt == existing().scannedAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'quantity', 'note', 'sessionName', 'syncedToSupabase', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['syncedToSupabase', 'updatedAt'])
        );
      allow delete: if canUseBarcode() && isValidId(scanId)
        && (existing().ownerId == request.auth.uid || isManagerOrAdmin());
    }

    // Legacy Work Schedules collection
    match /work_schedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && isAuthorizedUser() && (
        existing().ownerId == request.auth.uid || isManagerOrAdmin() || isViewer()
      );
      allow list: if isAuthorizedUser() && (
        existing().ownerId == request.auth.uid || isManagerOrAdmin() || isViewer()
      );
      allow create: if canUseSchedule() && isValidId(scheduleId)
        && isValidWorkSchedule(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().ownerEmail.lower() == request.auth.token.email.lower()
        && incoming().createdAt == request.time;
      allow update: if canUseSchedule() && isValidId(scheduleId)
        && (existing().ownerId == request.auth.uid || isManagerOrAdmin())
        && (existing().status != 'cancelled' || isAdmin())
        && isValidWorkSchedule(incoming())
        && incoming().ownerId == existing().ownerId
        && incoming().ownerEmail == existing().ownerEmail
        && incoming().createdAt == existing().createdAt
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'employeeName', 'title', 'workDate', 'shiftType', 'startTime', 'endTime',
            'location', 'status', 'note', 'syncedToSupabase', 'updatedAt'
          ]) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['syncedToSupabase', 'updatedAt'])
        );
      allow delete: if canUseSchedule() && isValidId(scheduleId)
        && (existing().ownerId == request.auth.uid || isManagerOrAdmin());
    }

    // Shift Registrations collection
    match /shiftRegistrations/{regId} {
      allow get: if isValidId(regId) && isAuthorizedUser() && (
        existing().staffUid == request.auth.uid
        || request.auth.uid in existing().memberUids
        || isScheduleManager()
      );
      allow list: if isAuthorizedUser() && (
        existing().staffUid == request.auth.uid
        || request.auth.uid in existing().memberUids
        || isScheduleManager()
      );
      allow create: if canUseSchedule() && isValidId(regId)
        && isValidShiftRegistration(incoming())
        && incoming().staffUid == request.auth.uid
        && incoming().createdBy == request.auth.uid
        && incoming().status == 'pending'
        && incoming().createdAt == request.time;
      allow update: if isScheduleManager() && isValidId(regId)
        && isValidShiftRegistration(incoming())
        && (existing().status == 'pending' || isScheduleAdmin())
        && incoming().staffUid == existing().staffUid
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && (
          (incoming().status in ['approved', 'rejected']
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])) ||
          (isScheduleAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'shiftType', 'date', 'updatedAt']))
        );
      allow delete: if isValidId(regId) && (
        isScheduleManager()
        || (canUseSchedule() && existing().staffUid == request.auth.uid && existing().status == 'pending')
      );
    }

    // Official Weekly Work Schedules collection
    match /workSchedules/{scheduleId} {
      allow get: if isValidId(scheduleId) && isAuthorizedUser() && (
        existing().isPublished == true
        || existing().staffUid == request.auth.uid
        || request.auth.uid in existing().memberUids
        || isScheduleEditor()
      );
      allow list: if isAuthorizedUser() && (
        existing().isPublished == true
        || existing().staffUid == request.auth.uid
        || request.auth.uid in existing().memberUids
        || isScheduleEditor()
      );
      allow create: if isScheduleEditor() && isValidId(scheduleId)
        && isValidOfficialWorkSchedule(incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && (
          incoming().sourceRegId == null
          || existsAfter(/databases/$(database)/documents/shiftRegistrations/$(incoming().sourceRegId))
        );
      allow update: if isScheduleEditor() && isValidId(scheduleId)
        && isValidOfficialWorkSchedule(incoming())
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().sourceRegId == existing().sourceRegId
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'staffUid', 'staffName', 'department', 'date', 'shiftType',
          'startTime', 'endTime', 'isPublished', 'note', 'isTrucDam',
          'memberUids', 'updatedAt'
        ]);
      allow delete: if isScheduleManager() && isValidId(scheduleId);
    }

    // Weekly Matrix Display Config collection
    match /scheduleConfigs/{configId} {
      allow get: if isValidId(configId) && isAuthorizedUser();
      allow list: if false;
      allow create: if isScheduleEditor() && configId == 'weekly_matrix'
        && isValidScheduleConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isScheduleEditor() && configId == 'weekly_matrix'
        && isValidScheduleConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'sortMode', 'customOrder', 'hiddenUids', 'memberUids',
          'updatedBy', 'updatedByName', 'updatedAt'
        ]);
      allow delete: if false;
    }
  }
}
